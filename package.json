{
  "name": "glitchofhands",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "sync": "npm run sync:ignores && npm run sync:css",
